// CERP 2.0 - Database Entity Relationship Diagram (DBML)
// Copy and paste this into https://dbdiagram.io to visualize

Project CERP {
  database_type: 'PostgreSQL'
  Note: 'Comprehensive Extension and Research Platform 2.0'
}

// ==================== AUTHENTICATION & USERS ====================

Table auth_users {
  id uuid [pk, note: 'Supabase Auth user ID']
  email text [unique, not null]
  encrypted_password text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  Note: 'Supabase authentication table'
}

Table members {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id text [unique, note: 'Links to auth.users.id']
  first text [not null]
  last text [not null]
  mi text [default: 'N/A']
  suffix text
  email text [unique]
  contact text
  address text
  gender text
  dob text
  role text [note: 'e.g., Professor, Associate Professor']
  type text [default: 'admin_staff', note: 'admin_staff, teaching_personnel']
  user_no text [note: 'Employee number']
  photo_url text [note: 'Cloudinary URL']
  is_faculty boolean [default: false, note: 'Teaching personnel flag']
  availability jsonb [note: 'Array of available days/times']
  created_at timestamp [default: `now()`]
  
  Indexes {
    email [unique]
    is_faculty
    type
  }
  
  Note: 'Faculty and staff members'
}

// ==================== ACADEMIC COURSES ====================

Table courses {
  id uuid [pk, default: `gen_random_uuid()`]
  course_code text [unique, not null, note: 'e.g., CHE 1, MATH 17']
  course_name text [not null]
  units integer [default: 3]
  lecture_hours integer [default: 0]
  lab_hours integer [default: 0]
  created_at timestamp [default: `now()`]
  
  Indexes {
    course_code [unique]
  }
  
  Note: 'Course catalog/master list'
}

Table course_term_offerings {
  id uuid [pk, default: `gen_random_uuid()`]
  course_id uuid [not null]
  school_year text [not null, note: '2024-2025']
  semester text [not null, note: '1 or 2']
  enabled_sections jsonb [note: 'Array of section names: ["A", "B", "C"]']
  created_at timestamp [default: `now()`]
  
  Indexes {
    (course_id, school_year, semester) [unique]
  }
  
  Note: 'Sections offered per course per term'
}

// ==================== SCHEDULING & TIMETABLE ====================

Table schedules {
  id uuid [pk, default: `gen_random_uuid()`]
  subj_code text [not null, note: 'Course code']
  subj_name text [note: 'Course name']
  prof text [note: 'Faculty name (not FK, text match)']
  room text [not null, note: 'Room name (not FK)']
  section text [not null, note: 'e.g., A, B, C']
  units integer [default: 3]
  day text [not null, note: 'e.g., MW, TTH, F']
  start text [not null, note: 'HH:MM format']
  end text [not null, note: 'HH:MM format']
  school_year text [not null, note: '2024-2025']
  semester text [not null, note: '1 or 2']
  created_at timestamp [default: `now()`]
  
  Indexes {
    school_year
    semester
    subj_code
    prof
    room
  }
  
  Note: 'Master schedule/timetable - Generated by GA'
}

Table rooms {
  id uuid [pk, default: `gen_random_uuid()`]
  room_name text [unique, not null, note: 'e.g., G2, G6, SLEC']
  capacity integer [default: 40]
  room_type text [note: 'lecture, lab, hybrid']
  created_at timestamp [default: `now()`]
  
  Indexes {
    room_name [unique]
  }
  
  Note: 'Available rooms/venues'
}

Table section_room_allocations {
  id uuid [pk, default: `gen_random_uuid()`]
  room_id uuid [not null]
  course_code text [not null]
  section text [not null]
  school_year text [not null]
  semester text [not null]
  day text [not null]
  time_start text [not null]
  time_end text [not null]
  created_at timestamp [default: `now()`]
  
  Indexes {
    room_id
    (course_code, section, school_year, semester)
  }
  
  Note: 'Room-section assignments with time slots'
}

// ==================== FACULTY ASSIGNMENTS ====================

Table faculty_courses {
  id uuid [pk, default: `gen_random_uuid()`]
  faculty_id uuid [not null]
  course_id uuid [not null]
  section text [note: 'Which section they teach']
  school_year text [not null]
  semester text [not null]
  units integer [note: 'Workload units for this assignment']
  created_at timestamp [default: `now()`]
  
  Indexes {
    faculty_id
    course_id
    (faculty_id, course_id, section, school_year, semester) [unique]
  }
  
  Note: 'Actual faculty teaching assignments'
}

Table faculty_eligible_courses {
  id uuid [pk, default: `gen_random_uuid()`]
  faculty_id uuid [not null]
  course_id uuid [not null]
  max_units integer [note: 'Max units allowed for this course']
  created_at timestamp [default: `now()`]
  
  Indexes {
    faculty_id
    course_id
    (faculty_id, course_id) [unique]
  }
  
  Note: 'Faculty eligibility/qualifications - who CAN teach what'
}

Table custom_term_blocks {
  id uuid [pk, default: `gen_random_uuid()`]
  member_id uuid [not null]
  school_year text [not null]
  semester text [not null]
  day text [not null, note: 'e.g., M, T, W']
  time_start text [not null]
  time_end text [not null]
  label text [note: 'Reason for block, e.g., Meeting, Personal']
  created_at timestamp [default: `now()`]
  
  Indexes {
    member_id
    (member_id, school_year, semester)
  }
  
  Note: 'Faculty unavailability/blocked time slots'
}

// ==================== RESEARCH & EXTENSION ====================

Table research_extensions {
  id uuid [pk, default: `gen_random_uuid()`]
  member_id uuid [not null]
  title text [not null]
  type text [not null, note: 'research or extension']
  start_date date
  end_date date
  status text [note: 'ongoing, completed, pending']
  role text [note: 'Lead Researcher, Co-Researcher']
  funding_source text
  budget decimal
  description text
  evidence_url text [note: 'Cloudinary URL for supporting documents']
  created_at timestamp [default: `now()`]
  
  Indexes {
    member_id
    type
    status
  }
  
  Note: 'Research projects and extension programs'
}

Table administrative_works {
  id uuid [pk, default: `gen_random_uuid()`]
  member_id uuid [not null]
  position text [note: 'e.g., Department Chair, Committee Head']
  designation text
  committee text
  start_date date
  end_date date
  status text [note: 'active, completed']
  workload_units integer [note: 'Administrative load units']
  description text
  evidence_url text [note: 'Cloudinary URL']
  created_at timestamp [default: `now()`]
  
  Indexes {
    member_id
    status
  }
  
  Note: 'Administrative duties and designations'
}

// ==================== CHE CHATBOT SYSTEM ====================

Table che_conversations {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id text [not null, note: 'Links to auth.users.id']
  title text [default: 'New Conversation']
  is_system boolean [default: false, note: 'System conversations like Schedule Generation']
  is_archived boolean [default: false]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  Indexes {
    user_id
    (updated_at) [name: 'idx_updated_desc']
  }
  
  Note: 'CHE AI assistant conversation threads'
}

Table che_messages {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null, note: 'CASCADE DELETE']
  role text [not null, note: 'user, assistant, or system']
  content text [not null]
  metadata jsonb [default: '{}', note: 'Optional JSON data for actions, forms']
  created_at timestamp [default: `now()`]
  
  Indexes {
    conversation_id
    created_at
  }
  
  Note: 'Individual messages within CHE conversations'
}

// ==================== SYSTEM MANAGEMENT ====================

Table audit_log {
  id uuid [pk, default: `gen_random_uuid()`]
  action_type text [not null, note: 'SCHEDULE_GENERATED, MEMBER_CREATED, etc.']
  description text [not null]
  performed_by text [note: 'User ID who performed action']
  performed_by_email text
  target_type text [note: 'schedule, member, course, etc.']
  target_id text [note: 'ID of affected entity']
  target_name text [note: 'Name/label of affected entity']
  metadata jsonb [note: 'Additional context']
  created_at timestamp [default: `now()`]
  
  Indexes {
    action_type
    performed_by
    target_type
    created_at [name: 'idx_audit_created_desc']
  }
  
  Note: 'System-wide audit trail and activity log'
}

Table landing_content {
  id uuid [pk, default: `gen_random_uuid()`]
  section_key text [unique, not null, note: 'hero, about, features, news, events']
  content_type text [not null, note: 'text, image, card, list']
  title text
  body text
  image_url text [note: 'Cloudinary URL']
  link_url text
  display_order integer [default: 0]
  is_published boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  Indexes {
    section_key [unique]
    is_published
    display_order
  }
  
  Note: 'Landing page dynamic content management'
}

// ==================== RELATIONSHIPS ====================

// Authentication & Core Users
Ref: members.user_id - auth_users.id [note: '1:1 - Member linked to auth user']

// Course Management
Ref: course_term_offerings.course_id > courses.id [note: 'M:1 - Offerings per course']

// Faculty Assignments
Ref: faculty_courses.faculty_id > members.id [note: 'M:1 - Faculty teaching assignments']
Ref: faculty_courses.course_id > courses.id [note: 'M:1 - Course assignments']
Ref: faculty_eligible_courses.faculty_id > members.id [note: 'M:1 - Faculty eligibility']
Ref: faculty_eligible_courses.course_id > courses.id [note: 'M:1 - Course eligibility']
Ref: custom_term_blocks.member_id > members.id [note: 'M:1 - Faculty unavailability']

// Room Allocations
Ref: section_room_allocations.room_id > rooms.id [note: 'M:1 - Room assignments']

// Research & Administration
Ref: research_extensions.member_id > members.id [note: 'M:1 - Faculty research/extension']
Ref: administrative_works.member_id > members.id [note: 'M:1 - Faculty admin duties']

// CHE Chatbot
Ref: che_conversations.user_id > auth_users.id [note: 'M:1 - User conversations']
Ref: che_messages.conversation_id > che_conversations.id [note: 'M:1 - Messages in conversation, CASCADE DELETE']

// ==================== TABLE GROUPS (for visualization) ====================

TableGroup authentication {
  auth_users
  members
  
  Note: 'User Authentication & Profiles'
}

TableGroup courses_catalog {
  courses
  course_term_offerings
  
  Note: 'Course Catalog & Offerings'
}

TableGroup scheduling {
  schedules
  rooms
  section_room_allocations
  
  Note: 'Timetable & Room Management'
}

TableGroup faculty_management {
  faculty_courses
  faculty_eligible_courses
  custom_term_blocks
  
  Note: 'Faculty Assignments & Workload'
}

TableGroup research_admin {
  research_extensions
  administrative_works
  
  Note: 'Research, Extension & Admin Work'
}

TableGroup che_system {
  che_conversations
  che_messages
  
  Note: 'CHE AI Assistant'
}

TableGroup system_management {
  audit_log
  landing_content
  
  Note: 'System Logs & Content'
}
